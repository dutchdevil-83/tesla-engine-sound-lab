    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.16.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^5.0.5"
  }
